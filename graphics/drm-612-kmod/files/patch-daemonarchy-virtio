+#if defined(CONFIG_DEBUG_FS)
+	.debugfs_init = virtio_gpu_debugfs_init,
+#endif
+	.gem_prime_import = virtgpu_gem_prime_import,
+	.gem_prime_import_sg_table = virtgpu_gem_prime_import_sg_table,
