diff --git efifb/efi_fb_layout.h efifb/efi_fb_layout.h
new file mode 100644
index 0000000000..9fdbc2cb91
--- /dev/null
+++ efifb/efi_fb_layout.h
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Copyright (c) 2026 Daemonarchy contributors. */
+#ifndef EFIFB_DRM_LAYOUT_H
+#define EFIFB_DRM_LAYOUT_H
+#ifdef _KERNEL
+#include <sys/types.h>
+#include <sys/stdint.h>
+#else
+#include <stdint.h>
+#endif
+
+#define EFIFB_DRM_MAX_DIMENSION 8192U
+#define EFIFB_DRM_MAX_BYTES (256ULL * 1024 * 1024)
+#define EFIFB_DRM_XRGB8888 1
+#define EFIFB_DRM_XBGR8888 2
+
+struct efifb_drm_layout {
+ uint64_t address, size;
+ uint32_t width, height, stride;
+ uint32_t red, green, blue, reserved;
+};
+
+/* Validate the complete scanout extent before a physical mapping or copy. */
+static inline int
+efifb_drm_layout_valid(const struct efifb_drm_layout *f, uint32_t *pitch,
+    unsigned int *format)
+{
+ uint64_t bytes;
+ if (f->address == 0 || f->size == 0 || f->size > EFIFB_DRM_MAX_BYTES ||
+     f->address > UINT64_MAX - f->size ||
+     f->address + f->size > UINT64_MAX - 65535 ||
+     f->width == 0 || f->height == 0 ||
+     f->width > EFIFB_DRM_MAX_DIMENSION ||
+     f->height > EFIFB_DRM_MAX_DIMENSION || f->stride < f->width ||
+     f->stride > UINT32_MAX / 4)
+  return (0);
+ bytes = (uint64_t)f->stride * 4 * f->height;
+ if (bytes > f->size || f->green != 0x0000ff00 ||
+     (f->reserved != 0 && f->reserved != 0xff000000))
+  return (0);
+ if (f->red == 0x00ff0000 && f->blue == 0x000000ff)
+  *format = EFIFB_DRM_XRGB8888;
+ else if (f->red == 0x000000ff && f->blue == 0x00ff0000)
+  *format = EFIFB_DRM_XBGR8888;
+ else
+  return (0);
+ *pitch = f->stride * 4;
+ return (1);
+}
+#endif
