+
+CFLAGS+= '-DKBUILD_MODNAME="efifb_drm"'
+CFLAGS+= '-DLINUXKPI_PARAM_PREFIX=efifb_drm_' -DDRM_SYSCTL_PARAM_PREFIX=_efifb_drm
