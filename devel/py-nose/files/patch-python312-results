+def _legacy_import_error(exc_info, module_name):
+    kind, error, tb = exc_info
+    if sys.version_info >= (3, 6) and isinstance(error, ModuleNotFoundError):
+        missing = error.name
+        if missing and (module_name == missing or
+                        module_name.startswith(missing + '.')):
+            # Keep Nose's requested-module category and the original cause.
+            legacy = ImportError(str(error), name=missing, path=error.path)
+            legacy.__cause__ = error
+            return ImportError, legacy, tb
+    return exc_info
