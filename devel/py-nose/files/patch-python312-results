+def _method_function(method):
+    return getattr(method, '__func__', getattr(method, 'im_func', method))
+
+
+def _unittest_case_info(test):
+    if not isinstance(test, unittest.TestCase):
+        return None
+    method = getattr(test, '_testMethodName', None)
+    if method is None:
+        method = getattr(test, '_TestCase__testMethodName', None)
+    if method is not None:
+        return test.__class__, method
+    return None
+
+
+def _unittest_case_id(test):
+    method = test.id
+    info = _unittest_case_info(test)
+    if (info is not None and
+            _method_function(method) is _method_function(unittest.TestCase.id)):
+        cls, name = info
+        return '%s.%s.%s' % (cls.__module__, cls.__name__, name)
+    return method()
+
+
+def _unittest_case_str(test):
+    info = _unittest_case_info(test)
+    if (info is not None and _method_function(test.__class__.__str__) is
+            _method_function(unittest.TestCase.__str__)):
+        cls, name = info
+        return '%s (%s.%s)' % (name, cls.__module__, cls.__name__)
+    return str(test)
+
