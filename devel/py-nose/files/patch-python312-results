--- /dev/null
+++ fix_imp_new_module.py
@@ -0,0 +1,49 @@
+"""Translate legacy module-construction imports with no other imp usage."""
+from lib2to3 import fixer_base, pytree
+from lib2to3.fixer_util import Name
+from lib2to3.pgen2 import token
+from lib2to3.pygram import python_symbols as syms
+
+
+class FixImpNewModule(fixer_base.BaseFix):
+    BM_compatible = True
+    run_order = 4
+    PATTERN = "import_name< 'import' 'imp' > | power< 'imp' trailer< '.' 'new_module' > any* >"
+
+    def start_tree(self, tree, filename):
+        super(FixImpNewModule, self).start_tree(tree, filename)
+        self.safe = True
+        for leaf in tree.leaves():
+            if leaf.type != token.NAME:
+                continue
+            if leaf.value == '_nose_types':
+                self.safe = False
+                break
+            if leaf.value != 'imp':
+                continue
+            parent = leaf.parent
+            if parent.type == syms.import_name and len(parent.children) == 2:
+                continue
+            if (parent.type == syms.power and parent.children[0] is leaf
+                    and len(parent.children) > 1
+                    and parent.children[1].type == syms.trailer
+                    and len(parent.children[1].children) == 2
+                    and parent.children[1].children[0].value == '.'
+                    and parent.children[1].children[1].value == 'new_module'):
+                continue
+            self.safe = False
+            break
+
+    def transform(self, node, results):
+        if not self.safe:
+            return None
+        new = node.clone()
+        if node.type == syms.import_name:
+            old = new.children[1]
+            old.replace(pytree.Node(syms.dotted_as_name, [
+                Name('types', prefix=old.prefix), Name('as', prefix=' '),
+                Name('_nose_types', prefix=' ')]))
+        else:
+            new.children[0].value = '_nose_types'
+            new.children[1].children[1].value = 'ModuleType'
+        return new
