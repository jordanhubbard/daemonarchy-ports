# MAINTAINER:	portmgr@FreeBSD.org

actions: [file]
post-install: <<EOD
  case "%@" in
  /*) cat="%@" ;;
  *) cat="%D/%@" ;;
  esac
  case "%@" in
  *.xml)
    xmlcatmgr_cmd="xmlcatmgr -c ${PKG_ROOTDIR}%D/share/xml/catalog.ports"
    xmlcatmgr_type="nextCatalog"
  ;;
  *)
    xmlcatmgr_cmd="xmlcatmgr -sc ${PKG_ROOTDIR}%D/share/sgml/catalog.ports"
    xmlcatmgr_type="CATALOG"
  ;;
  esac
  # Upgrades run post-install without the old post-deinstall hook.
  # Check the entry type too: a PUBLIC/URI entry may share the identifier.
  entries=$(${xmlcatmgr_cmd} lookup "${cat}" 2>/dev/null)
  status=$?
  if [ "${status}" -gt 1 ]; then
    exit "${status}"
  fi
  if ! printf '%s\n' "${entries}" | grep -q "^${xmlcatmgr_type} "; then
    ${xmlcatmgr_cmd} add "${xmlcatmgr_type}" "${cat}" || exit "$?"
  fi
EOD
post-deinstall: <<EOD
  case "%@" in
  /*) cat="%@" ;;
  *) cat="%D/%@" ;;
  esac
  case "%@" in
  *.xml)
    xmlcatmgr_cmd="xmlcatmgr -c ${PKG_ROOTDIR}%D/share/xml/catalog.ports remove nextCatalog"
  ;;
  *)
    xmlcatmgr_cmd="xmlcatmgr -sc ${PKG_ROOTDIR}%D/share/sgml/catalog.ports remove CATALOG"
  ;;
  esac
  ${xmlcatmgr_cmd} ${cat} || exit "$?"
EOD
