# pkg records the immediate directory touched by a package file.
path: [ "%%PREFIX%%/share/fonts", "%%LOCALBASE%%/lib/X11/fonts", "%%LOCALBASE%%/etc/fonts/conf.d" ]
path_glob: [ "%%PREFIX%%/share/fonts/*", "%%LOCALBASE%%/lib/X11/fonts/*" ]
trigger: {
	type: lua
	sandbox: false
	script: <<EOS
print("Running fc-cache to build fontconfig cache...")
pkg.exec({"%%PREFIX%%/bin/fc-cache", "-s" })
EOS
}
