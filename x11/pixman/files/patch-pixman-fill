+/* SPDX-License-Identifier: MIT */
+#include <pixman.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define CHECK(c) do { if (!(c)) { fprintf (stderr, "fill bounds: line %d\n", __LINE__); exit (1); } } while (0)
+
+int main (void)
+{
+    const pixman_op_t ops[] = { PIXMAN_OP_SRC, PIXMAN_OP_OVER, PIXMAN_OP_CLEAR };
+    const pixman_color_t color = { 65535, 0, 65535, 65535 };
+    const pixman_rectangle16_t rectangles[] = { { -1, -1, 2, 2 }, { 3, 3, 2, 2 } };
+    const pixman_box32_t boxes[] = { { -1, -1, 1, 1 }, { 3, 3, 5, 5 } };
+    const pixman_box32_t wide_box = { INT32_MIN, INT32_MIN, INT32_MAX, INT32_MAX };
+    const pixman_format_code_t formats[] = {
+        PIXMAN_a8r8g8b8, PIXMAN_r5g6b5, PIXMAN_a8
+    };
+    const unsigned pixel_bytes[] = { 4, 2, 1 };
+    const uint32_t sentinels[] = { 0x12121212, 0x1212, 0x12 };
+    const uint32_t filled_pixels[] = { 0xffff00ff, 0xf81f, 0xff };
+    unsigned format, api, op, clipped;
+    int x, y;
+
+    for (format = 0; format < sizeof (formats) / sizeof (formats[0]); format++)
+    for (api = 0; api < 3; api++)
+    for (op = 0; op < sizeof (ops) / sizeof (ops[0]); op++)
+    for (clipped = 0; clipped < 3; clipped++)
+    {
+        uint32_t storage[16 * 16];
+        uint8_t *pixels = (uint8_t *) storage;
+        unsigned bpp = pixel_bytes[format];
+        pixman_image_t *image;
+        pixman_region32_t clip;
+
+        memset (storage, 0x12, sizeof (storage));
+        /* Padding makes every address touched by the unfixed implementation
+         * valid too; assertions check the logical image and all padding.
+         */
+        image = pixman_image_create_bits (formats[format], 4, 4,
+                    (uint32_t *) (pixels + (4 * 16 + 4) * bpp), 16 * bpp);
+        CHECK (image != NULL);
+        if (clipped)
+        {
+            unsigned size = clipped == 1 ? 4 : 1;
+            pixman_region32_init_rect (&clip, 0, 0, size, size);
+            CHECK (pixman_image_set_clip_region32 (image, &clip));
+            pixman_region32_fini (&clip);
+        }
+        if (api == 0)
+            CHECK (pixman_image_fill_rectangles (ops[op], image, &color,
+                                                 2, rectangles));
+        else if (api == 2)
+            CHECK (pixman_image_fill_boxes (ops[op], image, &color, 1, &wide_box));
+        else
+            CHECK (pixman_image_fill_boxes (ops[op], image, &color, 2, boxes));
+
+        for (y = 0; y < 16; y++)
+        for (x = 0; x < 16; x++)
+        {
+            int logical_x = x - 4, logical_y = y - 4;
+            int painted = (logical_x == 0 && logical_y == 0) ||
+                          (logical_x == 3 && logical_y == 3 && clipped != 2);
+            if (api == 2)
+            {
+                int size = clipped == 2 ? 1 : 4;
+                painted = logical_x >= 0 && logical_x < size &&
+                          logical_y >= 0 && logical_y < size;
+            }
+            uint32_t expected = !painted ? sentinels[format] :
+                ops[op] == PIXMAN_OP_CLEAR ? 0 : filled_pixels[format];
+            uint32_t actual = 0;
+            const uint8_t *pixel = pixels + (y * 16 + x) * bpp;
+            if (bpp == 4)
+                memcpy (&actual, pixel, 4);
+            else if (bpp == 2)
+            {
+                uint16_t value;
+                memcpy (&value, pixel, 2);
+                actual = value;
+            }
+            else
+                actual = *pixel;
+            CHECK (actual == expected);
+        }
+        for (x = 16 * 16 * bpp; x < (int) sizeof (storage); x++)
+            CHECK (pixels[x] == 0x12);
+        pixman_image_unref (image);
+    }
+    return 0;
+}
